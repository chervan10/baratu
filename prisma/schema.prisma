// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  password  String
  name      String?
  savedList SavedItem[]
}

model SavedItem {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  productId Int
  nome      String
  imagem    String
  mercado   String
  cidade    String
  valor     Float
  categoria String
}

model Visitor {
  id          String   @id @default(cuid())
  mobile      String
  location    String
  browser     String
  sessionTime Int      @default(0)
  phoneSpec   String
  createdAt   DateTime @default(now())
}

model ContactSubmission {
  id            String   @id @default(uuid())
  fullName      String   @map("full_name")
  email         String
  phone         String?
  subject       String
  message       String
  verifiedEmail Boolean  @default(false) @map("verified_email")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otpCode   String   @map("otp_code")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_otps")
}

model VisitorAnalytics {
  id              String    @id @default(uuid())
  visitorId       String    @map("visitor_id")
  deviceName      String    @map("device_name")
  deviceType      String    @map("device_type")
  browser         String
  browserVersion  String    @map("browser_version")
  operatingSystem String    @map("operating_system")
  osVersion       String    @map("os_version")
  screenWidth     Int       @map("screen_width")
  screenHeight    Int       @map("screen_height")
  pixelRatio      Float     @map("pixel_ratio")
  language        String
  timezone        String
  country         String
  city            String
  region          String
  latitude        Float?
  longitude       Float?
  sessionStart    DateTime  @map("session_start")
  sessionEnd      DateTime? @map("session_end")
  sessionDuration Int       @map("session_duration")
  visitDate       DateTime  @map("visit_date")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("visitor_analytics")
}

model AdminLockout {
  id             String    @id @default(uuid())
  ipAddress      String    @unique @map("ip_address")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("admin_lockouts")
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique @map("order_number")
  customerName  String      @map("customer_name")
  customerEmail String      @map("customer_email")
  customerPhone String      @map("customer_phone")
  country       String
  provinceState String?     @map("province_state")
  city          String
  address       String
  postalCode    String      @map("postal_code")
  orderNotes    String?     @map("order_notes")
  subtotal      Float
  shippingCost  Float       @map("shipping_cost")
  tax           Float       @default(0)
  discount      Float       @default(0)
  totalAmount   Float       @map("total_amount")
  orderStatus   String      @default("Pending") @map("order_status") // Pending, Confirmed, Processing, Shipped, Delivered, Cancelled
  createdAt     DateTime    @default(now()) @map("created_at")
  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String @map("order_id")
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int    @map("product_id")
  productName String @map("product_name")
  quantity    Int
  unitPrice   Float  @map("unit_price")
  totalPrice  Float  @map("total_price")

  @@map("order_items")
}


